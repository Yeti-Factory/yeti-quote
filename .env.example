# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file — it is in .gitignore.

# --- PostgreSQL et authentification natifs OVH (server-only) ---
DATABASE_URL="postgresql://yeti_quote:CHANGE_ME@database:5432/yeti_quote"
BETTER_AUTH_SECRET="CHANGE_ME_32_CARACTERES_MINIMUM"
BETTER_AUTH_URL="https://yeti-quote.yeti-factory.com"
TRUSTED_ORIGINS="https://yeti-quote.yeti-factory.com"

# --- Email (invitations d'installation PWA) ---
# Clé API Resend (https://resend.com) — server-only.
RESEND_API_KEY=""
# Expéditeur des emails transactionnels.
EMAIL_FROM="Yeti Factory <no-reply@yeti-factory.com>"
# URL publique de l'application, utilisée dans les liens des emails.
APP_PUBLIC_URL=https://yeti-quote.yeti-factory.com

# --- Microsoft 365 / bibliothèque partagée (server-only) ---
# Application Entra ID autorisée uniquement sur le site SharePoint choisi.
M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""
M365_SITE_ID=""
M365_DRIVE_ID=""
# Dossier racine sous lequel YetiQuote peut naviguer et créer les dossiers clients/projets.
M365_ROOT_FOLDER_ID=""
M365_ROOT_FOLDER_NAME="Partage"

# Optional — the application already defaults to "node-server" for Coolify.
# Set this only if another Nitro deployment target is needed.
# NITRO_PRESET="node-server"
